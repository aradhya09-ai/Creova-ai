# CREOVA AI Backend Configuration
# Copy this file to .env and fill in your values

# Server
HOST=0.0.0.0
PORT=8000

# Storage
STORAGE_BACKEND=local
GENERATED_DIR=../generated
UPLOAD_DIR=../uploads

# Database (SQLite)
DATABASE_URL=sqlite:///./creova.db

# --- AI Providers ---
# When blank, the system runs in Demo Mode with sample assets.
# Enter values to enable live generation.

# Hugging Face Inference API token (for free tier image/text models)
HUGGINGFACE_TOKEN=

# Default HF model IDs used by the image service
HF_IMAGE_MODEL=stabilityai/sdxl-turbo
HF_IMAGE_FALLBACK_MODEL=black-forest-labs/FLUX.1-schnell

# Compatible image endpoint (e.g. a self-hosted A1111 / SD WebUI / ComfyUI)
IMG_LOCAL_ENDPOINT=
# e.g. http://127.0.0.1:7860

# Compatible video endpoint
VIDEO_ENDPOINT=

# Google Veo 2 video (free tier) — get a free key at aistudio.google.com
# When set, video generation uses Veo 2 (best free quality), up to ~10 clips/day.
GEMINI_API_KEY=
VEO_MODEL=veo-2.0-generate-001

# Local text-to-speech executables / services
TTS_ENDPOINT=

# Max concurrent generations per user
MAX_CONCURRENT_GENERATIONS=3